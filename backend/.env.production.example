# Production Environment Variables
# Copy this file to .env and update values for your deployment

# Database Configuration
# Automatically set by Render database service
DATABASE_URL="postgresql://username:password@host:port/database"

# Server Configuration
NODE_ENV="production"
PORT=5000

# Security Configuration
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters"

# CORS Configuration
# Comma-separated list of allowed frontend origins
CORS_ORIGIN="https://yourdomain.vercel.app,https://www.yourdomain.com"

# WebSocket Configuration
# Optional: Override WebSocket URL if different from API
WS_URL="https://your-backend.onrender.com"

# Logging Configuration
LOG_LEVEL="info"
