# Production Environment Variables for Frontend
# Copy this file to .env.production and update values

# API Configuration
# Base URL for HTTP API requests to backend
# Should include protocol (https) and domain, but no trailing slash
NEXT_PUBLIC_API_URL="https://your-backend.onrender.com"

# WebSocket Configuration
# WebSocket server URL for real-time connections (Socket.IO)
# Must match your backend deployment URL with proper protocol
NEXT_PUBLIC_WS_URL="https://your-backend.onrender.com"

# Optional: Application Configuration
# Application name and version for debugging
NEXT_PUBLIC_APP_NAME="DevBoard"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Optional: Feature Flags
# Enable/disable features for production
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_DEBUG="false"

# Optional: Environment Identifier
# Helps with debugging and monitoring
NEXT_PUBLIC_ENVIRONMENT="production"
